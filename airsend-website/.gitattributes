# Los binarios de descarga NUNCA deben pasar por conversion de fin de linea:
# Git los corromperia y el APK/IPK quedaria inservible al descargarlo.
*.apk  binary
*.ipk  binary
*.zip  binary
*.ico  binary
*.png  binary
*.jpg  binary
*.webp binary

# Texto normalizado a LF
*.html text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
